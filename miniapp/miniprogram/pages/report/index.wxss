/* miniapp/miniprogram/pages/report/index.wxss */
.report-page {
  padding: 16px;
  padding-bottom: 40px;
  min-height: 100vh;
}

.month-header {
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  color: var(--ink-blue);
  padding: 12px 0 16px;
}

/* 汇总卡片 */
.summary-card {
  margin-bottom: 24px;
}

.summary-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 0 12px;
}

.big-amount {
  font-size: 36px;
  font-weight: bold;
  color: var(--ink-blue);
  line-height: 1.2;
}

.big-label {
  font-size: 14px;
  color: var(--steel-gray);
  margin-top: 4px;
}

.summary-details {
  display: flex;
  justify-content: space-around;
  padding-top: 16px;
  border-top: 1px solid var(--pale-ink);
  margin-top: 8px;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 64px;
}

.detail-val {
  font-size: 20px;
  font-weight: 600;
  color: var(--ink-black);
}

.detail-lbl {
  font-size: 12px;
  color: var(--steel-gray);
  margin-top: 2px;
}

/* 分类占比 */
.category-bars {
  background: var(--paper-white);
  border-radius: 12px;
  padding: 20px 16px;
  margin-bottom: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.cat-row {
  display: flex;
  align-items: center;
  margin-bottom: 14px;
}

.cat-row:last-child {
  margin-bottom: 0;
}

.cat-label {
  width: 80px;
  font-size: 14px;
  color: var(--ink-black);
  flex-shrink: 0;
}

.cat-bar-track {
  flex: 1;
  height: 12px;
  background: var(--paper-texture);
  border-radius: 6px;
  margin: 0 10px;
  overflow: hidden;
}

.cat-bar-fill {
  height: 100%;
  background: var(--ink-blue);
  border-radius: 6px;
  transition: width 0.3s ease;
}

.cat-pct {
  width: 36px;
  font-size: 13px;
  color: var(--steel-gray);
  text-align: right;
  flex-shrink: 0;
}

/* 导出按钮 */
.btn-export {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: var(--ink-blue);
  color: #fff;
  border-radius: 10px;
  font-size: 17px;
  font-weight: 500;
  border: none;
}

.btn-export::after {
  border: none;
}

.btn-export:active {
  opacity: 0.8;
}
