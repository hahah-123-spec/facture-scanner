/* miniapp/miniprogram/pages/profile/index.wxss */
.profile-page {
  padding: 16px;
  padding-bottom: 40px;
  min-height: 100vh;
}

.section {
  background: var(--paper-white);
  border-radius: 12px;
  padding: 20px 16px;
  margin-bottom: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.section-title {
  display: block;
  font-size: 13px;
  color: var(--steel-gray);
  margin-bottom: 12px;
  font-weight: 500;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-label {
  font-size: 15px;
  color: var(--ink-black);
}

.setting-input {
  width: 100px;
  height: 36px;
  border: 1px solid var(--pale-ink);
  border-radius: 6px;
  padding: 0 10px;
  font-size: 15px;
  color: var(--ink-black);
  background: #fff;
  text-align: center;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-label {
  font-size: 15px;
  color: var(--ink-black);
}

.info-value {
  font-size: 15px;
  color: var(--steel-gray);
}

.btn-logout {
  margin-top: 40px;
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #e74c3c;
  color: #fff;
  border-radius: 10px;
  font-size: 17px;
  font-weight: 500;
  border: none;
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  opacity: 0.85;
}
