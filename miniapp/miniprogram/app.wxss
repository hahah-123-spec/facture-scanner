/** app.wxss */
page {
  --paper-white: #FCFAF7;
  --ink-blue: #1A3A6B;
  --ink-blue-light: #2D5A9E;
  --ink-black: #1E1E24;
  --steel-gray: #6B7280;
  --paper-texture: #F0EDE6;
  --pale-ink: #E2DED6;
  --seal-red: #C2413E;
  --stamp-green: #1F7D53;

  background-color: var(--paper-white);
  color: var(--ink-black);
  font-size: 14px;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.amount-large {
  font-size: 22px;
  font-weight: bold;
  color: var(--ink-black);
}

.text-title {
  font-size: 16px;
  color: var(--ink-black);
}

.text-body {
  font-size: 14px;
  color: var(--steel-gray);
}

.text-caption {
  font-size: 12px;
  color: var(--steel-gray);
}

.card {
  background-color: var(--paper-white);
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.btn-primary {
  min-height: 44px;
  background-color: var(--ink-blue);
  color: var(--paper-white);
  border-radius: 8rpx;
  padding: 0 32rpx;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-danger {
  min-height: 44px;
  background-color: var(--seal-red);
  color: var(--paper-white);
  border-radius: 8rpx;
  padding: 0 32rpx;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toast-success {
  background-color: var(--stamp-green);
  color: var(--paper-white);
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 14px;
}
