.detail-page {
  padding: 16px;
  padding-bottom: 32px;
}

.invoice-image {
  width: 100%;
  border-radius: 8px;
  margin-bottom: 16px;
  border: 1px solid var(--pale-ink);
}

.fields {
  background: #fff;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.field-group {
  margin-bottom: 16px;
}

.field-label {
  display: block;
  font-size: 13px;
  color: var(--steel-gray);
  margin-bottom: 4px;
}

.field-input {
  width: 100%;
  height: 40px;
  border: 1px solid var(--pale-ink);
  border-radius: 6px;
  padding: 0 12px;
  font-size: 15px;
  color: var(--ink-black);
  background: #fff;
  box-sizing: border-box;
}

.field-input[disabled] {
  border-color: transparent;
  background: transparent;
  padding: 0;
  color: var(--ink-black);
  font-weight: 500;
}

.field-row {
  display: flex;
  gap: 12px;
}

.field-group.half {
  flex: 1;
}

.amount-input {
  font-weight: 600;
  font-size: 16px;
}

.field-textarea {
  width: 100%;
  min-height: 72px;
  border: 1px solid var(--pale-ink);
  border-radius: 6px;
  padding: 8px 12px;
  font-size: 15px;
  color: var(--ink-black);
  background: #fff;
  box-sizing: border-box;
}

.field-textarea[disabled] {
  border-color: transparent;
  background: transparent;
  padding: 0;
  color: var(--ink-black);
}

.picker-value {
  height: 40px;
  line-height: 40px;
  border: 1px solid var(--pale-ink);
  border-radius: 6px;
  padding: 0 12px;
  font-size: 15px;
  color: var(--ink-black);
  background: #fff;
}

.detail-actions {
  margin-top: 24px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.detail-actions button {
  flex: 1;
  min-width: calc(50% - 6px);
}

.btn-secondary {
  min-height: 44px;
  background-color: var(--paper-white);
  color: var(--ink-blue);
  border-radius: 8rpx;
  padding: 0 32rpx;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--pale-ink);
}
